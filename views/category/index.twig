{% for index, category in categories %}
    {% set has_sub = category['children'] | length > 0 %}
    <li parent="{{ index }}"{% if has_sub %} class="has-sub"{% endif %}>
        <a href="/{{ category['slug'] }}">
            {{ category['name'] }}
            {% if has_sub %}<span class="nav-arrow" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endif %}
        </a>
        {% if category['children'] | length > 0 %}
            {% include 'category/child.twig' with {'categories': category['children']} %}
        {% endif %}
    </li>
{% endfor %}



<script>
    $(document).ready(function(){
        $(".owl-carousel").owlCarousel({
            loop: false,
            autoplay: true,
            autoplayTimeout: 5000,
            autoWidth: true,
            rewind: true,
            margin: 15,
            nav: true,
            rtl: {{ lang ? 'true' : 'false' }},
        });
        setTimeout(() => {
            $('#block{{ content['block_id'] }} .product-group-arrow-prev').click(function() {
                $('#block{{ content['block_id'] }} .owl-prev').click();
            })

            $('#block{{ content['block_id'] }} .product-group-arrow-next').click(function() {
                $('#block{{ content['block_id'] }} .owl-next').click();
            })
        }, 1000);
        $('#block{{ content['block_id'] }} .product-group').slideDown();
    });
</script>
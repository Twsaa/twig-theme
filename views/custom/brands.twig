<div id="block{{ content['block_id'] }}" class="brands-block">
    {% if content['settings']['brands_title'] %}
        <div class="text-center mb-5 section_title">
            <h3 class="display-4 text-black bg-transparent">{{ content['settings']['brands_title'] }}</h3>
        </div>
    {% endif %}

    <div id="slider{{ content['block_id'] }}" class="brands-slider mb-20 owl-carousel">
        {% for brand in content['settings']['brands'] %}
            <a href="/brands/{{ brand['name'] }}/brand-{{ brand['id'] }}" class="brand-card" title="{{ brand['name'] }}">
                <span class="brand-card__logo">
                    {% if brand['logo'] %}
                        <img src="{{ storage_url ~ brand['logo'] }}" alt="{{ brand['name'] }}" loading="lazy" />
                    {% else %}
                        <span class="brand-card__initial">{{ brand['name'] }}</span>
                    {% endif %}
                </span>
                <span class="brand-card__name">{{ brand['name'] }}</span>
            </a>
        {% endfor %}
    </div>
</div>
